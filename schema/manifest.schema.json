{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twistyroads.github.io/living-world-observatory/schema/manifest.schema.json",
  "title": "Living World Observatory Manifest",
  "type": "object",
  "required": ["contract_version", "world_id", "title", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string" },
    "world_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["world_day", "path"],
        "additionalProperties": false,
        "properties": {
          "world_day": { "type": "integer", "minimum": 0 },
          "path": { "type": "string", "pattern": "^data/" },
          "label": { "type": "string" }
        }
      }
    }
  }
}
